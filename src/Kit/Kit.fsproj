<Project Sdk="Microsoft.NET.Sdk">
  <!-- The in-browser animation kit, compiled by Fable to ES modules in engine/web. Main.js sets window.Stage
       and window.Kit (the API scene modules call) and runs the long-video frame. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interop.fs" />
    <Compile Include="Stage.fs" />
    <Compile Include="Draw.fs" />
    <Compile Include="Kit.fs" />
    <Compile Include="Frame.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.1" />
  </ItemGroup>
</Project>
